# This service exists for those older Deckard units that do not contain the new bootloader work
# that allows a unit to charge without booting.  For these, we inhibit SteamVR's auto-start
# and therefore need a way to manually start SteamVR while the system is running, which is
# what this service does.
[Unit]
Description=Service to start SteamVR when pressing power button on older bootloaders
After=systemd-user-sessions.service systemd-logind.service

# Only run if we don't have the u-boot charger feature
ConditionPathExists=!/sys/firmware/devicetree/base/chosen/u-boot,charger

[Service]
ExecStart=/usr/lib/powerbuttond/deckard-button-listener-for-older-bootloaders.py

[Install]
WantedBy=multi-user.target
